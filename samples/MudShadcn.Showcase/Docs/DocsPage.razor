<MudMainContent Class="docs-main">
    <MudContainer MaxWidth="MaxWidth.Large" Class="docs-container">
        <div id="docspage" class="docs-page">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
        <NavigationFooter />
        <SiteFooter />
    </MudContainer>
    <MudDrawer Class="docs-toc" @bind-Open="_tocOpen" Breakpoint="Breakpoint.Lg" Anchor="Anchor.End"
               ClipMode="DrawerClipMode.Always" Elevation="0" Color="Color.Transparent" aria-label="On this page">
        <MudPageContentNavigation @ref="_contentNavigation" Headline="On this page" SectionClassSelector="docs-section-anchor"
                                  ActivateFirstSectionAsDefault="true" />
    </MudDrawer>
</MudMainContent>
