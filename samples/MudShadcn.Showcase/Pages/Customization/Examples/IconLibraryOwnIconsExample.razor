<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.subtitle2" GutterBottom="true">Redrawn: MudBlazor's components use these icons too</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">Add</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Search" aria-label="Search" />
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" aria-label="Edit" />
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Large" />
        </MudStack>
    </div>
    <div>
        <MudText Typo="Typo.subtitle2" GutterBottom="true">Not redrawn: these stay Material's</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save">Save</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete" />
            <MudIconButton Icon="@Icons.Material.Filled.Favorite" aria-label="Like" />
            <MudIcon Icon="@Icons.Material.Filled.Home" Color="Color.Primary" Size="Size.Large" />
        </MudStack>
    </div>
</MudStack>
