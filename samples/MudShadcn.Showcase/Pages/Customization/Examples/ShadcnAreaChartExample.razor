<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Area Chart</MudText>
            <MudText Typo="Typo.body2">Showing total visitors for the last 6 months</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_series" ChartLabels="@_months"
                  ChartOptions="@_options" Width="100%" Height="260px" MatchBoundsToSize="true" />
    </MudCardContent>
</MudCard>

@code {
    private readonly LineChartOptions _options = MudShadcnChartOptions.Area();

    private readonly string[] _months = ["January", "February", "March", "April", "May", "June"];

    private readonly List<ChartSeries<double>> _series =
    [
        new() { Name = "Desktop", Data = new double[] { 186, 305, 237, 73, 209, 214 } },
    ];
}
