<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Pie Chart - Donut</MudText>
            <MudText Typo="Typo.body2">January - June 2024</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_series" ChartLabels="@_browsers"
                  ChartOptions="@_options" Width="100%" Height="260px" MatchBoundsToSize="true" />
    </MudCardContent>
</MudCard>

@code {
    private readonly DonutChartOptions _options = MudShadcnChartOptions.Donut();

    private readonly string[] _browsers = ["Chrome", "Safari", "Firefox", "Edge", "Other"];

    private readonly List<ChartSeries<double>> _series =
    [
        new() { Name = "Visitors", Data = new double[] { 275, 200, 287, 173, 190 } },
    ];
}
