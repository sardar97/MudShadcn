@inherits LayoutComponentBase
@inject ThemePreference ThemePreference
@inject ShowcaseTheme ShowcaseTheme

@* For the examples mudblazor.com shows in an iframe (a whole MudLayout of their own). *@
@if (_ready)
{
    <MudShadcnProvider Theme="ShowcaseTheme.Theme" Enabled="ShowcaseTheme.Design.Shadcn" IsDarkMode="_isDarkMode" FollowSystemDarkMode="_followSystem"
                       StyleHrefFormat="_content/MudShadcn/styles/{0}.css" />
    @if (ShowcaseFonts.Href(skipLoaded: true, ShowcaseTheme.Design.Font, ShowcaseTheme.Design.HeadingFont) is { } fontsHref)
    {
        <link @key="fontsHref" rel="stylesheet" href="@fontsHref" />
    }
    @Body
}

@code {
    private bool _ready, _isDarkMode, _followSystem = true;

    protected override async Task OnInitializedAsync()
    {
        await ShowcaseTheme.LoadAsync();

        if ((ShowcaseTheme.ModeFromAddress ?? await ThemePreference.GetAsync()) is { } dark)
        {
            _isDarkMode = dark;
            _followSystem = false;
        }

        _ready = true;
    }
}
