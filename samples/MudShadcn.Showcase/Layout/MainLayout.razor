@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemePreference ThemePreference
@inject ShowcaseTheme ShowcaseTheme
@implements IDisposable

@if (!_ready)
{
    return;
}

@* The readable style sheets, like MudShadcn.css in index.html. An app keeps the default (.min.css). *@
<MudShadcnProvider Theme="ShowcaseTheme.Theme" Enabled="Design.Shadcn" IsDarkMode="_isDarkMode" IsDarkModeChanged="OnDarkModeChanged" FollowSystemDarkMode="_followSystem"
                   StyleHrefFormat="_content/MudShadcn/styles/{0}.css" />

@* Only the web fonts the design uses (Geist is in index.html). A link in the body, as the provider's
   are: a <HeadContent> here would lose to the one of the page, which has its description in it. *@
@if (ShowcaseFonts.Href(skipLoaded: true, Design.Font, Design.HeadingFont) is { } fontsHref)
{
    <link @key="fontsHref" rel="stylesheet" href="@fontsHref" />
}

<MudLayout Class="docs-layout">
    <MudAppBar Elevation="0" Class="docs-appbar">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="@(IsGenerator ? "d-flex mr-1" : "d-flex d-md-none mr-1")"
                       OnClick="@(() => DrawerOpen = !DrawerOpen)" aria-label="Toggle navigation" />
        <a href="" class="docs-brand" aria-label="MudShadcn home">
            <Logo />
            <span>MudShadcn</span>
        </a>
        <a href="releases" class="docs-version d-none d-md-flex" title="Release notes"
           aria-label="@($"MudShadcn version {BuildInfo.MudShadcnVersion}, release notes")">v@(BuildInfo.MudShadcnVersion)</a>
        <nav class="docs-topnav d-none d-md-flex" aria-label="Main">
            <MudButton Href="getting-started/installation" Variant="Variant.Text" Class="@TopLinkClass(true, "getting-started")">Get Started</MudButton>
            <MudButton Href="docs/overview" Variant="Variant.Text" Class="@TopLinkClass(true, "docs", "components")">Docs</MudButton>
            <MudButton Href="customization/theme" Variant="Variant.Text" Class="@TopLinkClass(!IsGenerator, "customization")">Theme</MudButton>
            <MudButton Href="customization/theme-generator" Variant="Variant.Text" Class="@TopLinkClass(IsGenerator)">Generator</MudButton>
        </nav>
        <MudSpacer />
        <DocsSearch />
        @* The look: a button that names it where there is room, an icon below that. *@
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ExpandMore" Class="docs-look-button" OnClick="@context.ToggleAsync"
                           aria-label="@LookLabel" aria-haspopup="menu">@Design.LookName</MudButton>
                <MudIconButton Icon="@Icons.Material.Outlined.Palette" Color="Color.Inherit" Class="docs-look-icon" OnClick="@context.ToggleAsync"
                               title="@LookLabel" aria-label="@LookLabel" aria-haspopup="menu" />
            </ActivatorContent>
            <ChildContent>
                @* shadcn's styles, by shadcn's names, then MudBlazor's own look. *@
                @foreach (var look in Looks)
                {
                    var current = look.Shadcn == Design.Shadcn && (!look.Shadcn || look.Style == Design.Style);
                    @if (!look.Shadcn)
                    {
                        <MudDivider Class="my-1" />
                    }
                    <MudMenuItem OnClick="@(() => SetLookAsync(look))" aria-current="@(current ? "true" : null)">
                        <div class="d-flex align-center justify-space-between gap-6" style="min-width:7rem">
                            @look.LookName
                            @if (current)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                        </div>
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit"
                           OnClick="ToggleDarkModeAsync" aria-label="Toggle dark mode" />
        </MudTooltip>
        <MudTooltip Text="NuGet">
            <MudIconButton Href="https://www.nuget.org/packages/MudShadcn" Target="_blank" Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Inherit"
                           aria-label="Open the NuGet package" />
        </MudTooltip>
        <MudTooltip Text="GitHub">
            <MudIconButton Href="https://github.com/sardar97/MudShadcn" Target="_blank" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit"
                           Edge="Edge.End" aria-label="Open the GitHub repository" />
        </MudTooltip>
    </MudAppBar>

    @* The Theme Generator needs the width, so there the navigation starts closed (the menu button opens it). *@
    <MudDrawer Open="DrawerOpen" OpenChanged="@(open => DrawerOpen = open)" ClipMode="DrawerClipMode.Docked" Breakpoint="Breakpoint.Md" Elevation="0" Class="docs-nav-drawer"
               aria-label="Navigation">
        <NavMenu />
    </MudDrawer>

    @Body

    <MudScrollToTop TopOffset="400" Style="z-index:2000">
        <MudFab StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Color="Color.Primary" Size="Size.Small" aria-label="Scroll to top" />
    </MudScrollToTop>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _generatorDrawerOpen;
    private bool _ready;
    private bool _isDarkMode;
    private bool _followSystem = true;
    private string _section = "";
    private bool _isGenerator;

    // The looks the dropdown offers: every shadcn style, and MudBlazor's own (MudShadcnProvider's Enabled).
    private static readonly ShowcaseDesign[] Looks =
    [
        .. Enum.GetValues<ShadcnStyle>().Select(style => new ShowcaseDesign { Style = style }),
        new ShowcaseDesign { Shadcn = false },
    ];

    private bool IsGenerator => _isGenerator;

    private bool DrawerOpen
    {
        get => _isGenerator ? _generatorDrawerOpen : _drawerOpen;
        set
        {
            if (_isGenerator)
            {
                _generatorDrawerOpen = value;
            }
            else
            {
                _drawerOpen = value;
            }
        }
    }

    private ShowcaseDesign Design => ShowcaseTheme.Design;

    private string LookLabel => $"Look: {Design.LookName}. Choose a shadcn style or MudBlazor's own look";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        ShowcaseTheme.Changed += OnThemeChanged;
        _section = Section();
        _isGenerator = IsGeneratorPage();
        await ShowcaseTheme.LoadAsync();

        // An explicit choice wins over the OS setting (MudShadcnProvider follows the OS by default).
        if ((ShowcaseTheme.ModeFromAddress ?? await ThemePreference.GetAsync()) is { } dark)
        {
            _isDarkMode = dark;
            _followSystem = false;
        }

        _ready = true;
    }

    private void OnDarkModeChanged(bool dark) => _isDarkMode = dark;

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        _followSystem = false;
        await ThemePreference.SetAsync(_isDarkMode);
    }

    // The look only: the colours, radius and fonts chosen in the Theme Generator stay.
    private Task SetLookAsync(ShowcaseDesign look) =>
        ShowcaseTheme.SetAsync(look.Shadcn ? Design with { Shadcn = true, Style = look.Style } : Design with { Shadcn = false });

    private string Section() => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('/', '#', '?')[0];

    private bool IsGeneratorPage() =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('#', '?')[0].TrimEnd('/') == "customization/theme-generator";

    private string TopLinkClass(bool applies, params string[] sections) =>
        applies && (sections.Length == 0 || sections.Contains(_section)) ? "docs-topnav-link active" : "docs-topnav-link";

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        _section = Section();
        _isGenerator = IsGeneratorPage();
        StateHasChanged();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ShowcaseTheme.Changed -= OnThemeChanged;
    }
}
