@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemePreference ThemePreference
@implements IDisposable

@if (!_ready)
{
    return;
}

<MudShadcnProvider Theme="ShowcaseTheme.Theme" Enabled="_shadcn" IsDarkMode="_isDarkMode" IsDarkModeChanged="OnDarkModeChanged" FollowSystemDarkMode="_followSystem" />

<MudLayout Class="docs-layout">
    <MudAppBar Elevation="0" Class="docs-appbar">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="d-flex d-md-none mr-1"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <a href="" class="docs-brand" aria-label="MudShadcn home">
            <Logo />
            <span>MudShadcn</span>
        </a>
        <a href="releases" class="docs-version d-none d-md-flex" title="Release notes"
           aria-label="@($"MudShadcn version {BuildInfo.MudShadcnVersion}, release notes")">v@(BuildInfo.MudShadcnVersion)</a>
        <nav class="docs-topnav d-none d-md-flex" aria-label="Main">
            <MudButton Href="getting-started/installation" Variant="Variant.Text" Class="@TopLinkClass("getting-started")">Get Started</MudButton>
            <MudButton Href="docs/overview" Variant="Variant.Text" Class="@TopLinkClass("docs", "components")">Docs</MudButton>
            <MudButton Href="customization/theme" Variant="Variant.Text" Class="@TopLinkClass("customization")">Theme</MudButton>
        </nav>
        <MudSpacer />
        <DocsSearch />
        @* The look: a button that names it where there is room, an icon below that. *@
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ExpandMore" Class="docs-look-button" OnClick="@context.ToggleAsync"
                           aria-label="@LookLabel" aria-haspopup="menu">@LookName(_shadcn)</MudButton>
                <MudIconButton Icon="@Icons.Material.Outlined.Palette" Color="Color.Inherit" Class="docs-look-icon" OnClick="@context.ToggleAsync"
                               title="@LookLabel" aria-label="@LookLabel" aria-haspopup="menu" />
            </ActivatorContent>
            <ChildContent>
                @foreach (var shadcn in Looks)
                {
                    <MudMenuItem OnClick="@(() => SetLookAsync(shadcn))" aria-current="@(shadcn == _shadcn ? "true" : null)">
                        <div class="d-flex align-center justify-space-between gap-6" style="min-width:7rem">
                            @LookName(shadcn)
                            @if (shadcn == _shadcn)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                        </div>
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit"
                           OnClick="ToggleDarkModeAsync" aria-label="Toggle dark mode" />
        </MudTooltip>
        <MudTooltip Text="NuGet">
            <MudIconButton Href="https://www.nuget.org/packages/MudShadcn" Target="_blank" Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Inherit"
                           aria-label="Open the NuGet package" />
        </MudTooltip>
        <MudTooltip Text="GitHub">
            <MudIconButton Href="https://github.com/sardar97/MudShadcn" Target="_blank" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit"
                           Edge="Edge.End" aria-label="Open the GitHub repository" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Docked" Breakpoint="Breakpoint.Md" Elevation="0" Class="docs-nav-drawer"
               aria-label="Navigation">
        <NavMenu />
    </MudDrawer>

    @Body

    <MudScrollToTop TopOffset="400" Style="z-index:2000">
        <MudFab StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Color="Color.Primary" Size="Size.Small" aria-label="Scroll to top" />
    </MudScrollToTop>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _ready;
    private bool _isDarkMode;
    private bool _followSystem = true;
    private bool _shadcn = true;
    private string _section = "";

    // The looks the dropdown offers, as MudShadcnProvider's Enabled: the shadcn look, and MudBlazor's own.
    private static readonly bool[] Looks = [true, false];

    private static string LookName(bool shadcn) => shadcn ? "shadcn" : "MudBlazor";

    private string LookLabel => $"Look: {LookName(_shadcn)}. Choose the shadcn look or MudBlazor's own";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        _section = Section();
        _shadcn = await ThemePreference.GetShadcnAsync();

        // An explicit choice wins over the OS setting (MudShadcnProvider follows the OS by default).
        if (await ThemePreference.GetAsync() is { } dark)
        {
            _isDarkMode = dark;
            _followSystem = false;
        }

        _ready = true;
    }

    private void OnDarkModeChanged(bool dark) => _isDarkMode = dark;

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        _followSystem = false;
        await ThemePreference.SetAsync(_isDarkMode);
    }

    // MudShadcnProvider's Enabled: the same pages in MudBlazor's own look, to compare.
    private async Task SetLookAsync(bool shadcn)
    {
        if (_shadcn == shadcn)
        {
            return;
        }

        _shadcn = shadcn;
        await ThemePreference.SetShadcnAsync(shadcn);
    }

    private string Section() => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('/', '#', '?')[0];

    private string TopLinkClass(params string[] sections) => sections.Contains(_section) ? "docs-topnav-link active" : "docs-topnav-link";

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        _section = Section();
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
