@page "/tokens"

<PageTitle>Theme tokens · MudShadcn</PageTitle>

<PageHeader Title="Theme tokens" Description="shadcn's tokens as MudShadcnProvider emits them for the active mode, and the typography scale." />

<DemoSection Title="Colour tokens" Description="Each swatch is painted with var(--shadcn-*), the original OKLCH value.">
    <MudGrid Spacing="3">
        @foreach (var (name, value) in _tokens)
        {
            <MudItem xs="6" sm="4" md="3">
                <div class="demo-swatch" style="background:var(--shadcn-@name)"></div>
                <MudText Typo="Typo.subtitle2" Class="mt-1">--shadcn-@name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">@value</MudText>
            </MudItem>
        }
    </MudGrid>
</DemoSection>

<DemoSection Title="Radius scale" Description="Derived from --shadcn-radius (0.625rem): ×0.6, ×0.8, ×1, ×1.4, ×1.8.">
    <div class="demo-row">
        @foreach (var r in new[] { "sm", "md", "lg", "xl", "2xl" })
        {
            <div style="width:88px;height:64px;display:grid;place-items:center;border:1px solid var(--mud-palette-lines-default);background:var(--mud-palette-background-gray);border-radius:var(--shadcn-radius-@r)">
                <MudText Typo="Typo.caption">@r</MudText>
            </div>
        }
    </div>
</DemoSection>

<DemoSection Title="Typography">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h1">h1 · Taxing laughter</MudText>
        <MudText Typo="Typo.h2">h2 · The people of the kingdom</MudText>
        <MudText Typo="Typo.h3">h3 · The joke tax</MudText>
        <MudText Typo="Typo.h4">h4 · People stopped telling jokes</MudText>
        <MudText Typo="Typo.h5">h5 · Dialog title</MudText>
        <MudText Typo="Typo.h6">h6 · Card title</MudText>
        <MudText Typo="Typo.subtitle1">subtitle1 · 1rem medium</MudText>
        <MudText Typo="Typo.subtitle2">subtitle2 · 0.875rem medium</MudText>
        <MudText Typo="Typo.body1">body1 · The king, seeing how much happier his subjects were, realised the error of his ways.</MudText>
        <MudText Typo="Typo.body2" Color="Color.Tertiary">body2 · muted-foreground text at text-sm.</MudText>
        <MudText Typo="Typo.caption">caption · 0.75rem</MudText>
        <MudText Typo="Typo.overline">overline</MudText>
    </MudStack>
</DemoSection>

@code {
    // The provider re-renders this page's tokens when the mode flips; the swatches follow by CSS alone.
    private readonly IReadOnlyDictionary<string, string> _tokens = ShadcnTokens.Light
        .Where(t => !t.Key.StartsWith("chart") && !t.Key.StartsWith("sidebar-") && !t.Key.EndsWith("-background"))
        .ToDictionary(t => t.Key, t => $"{t.Value} / {ShadcnTokens.Dark[t.Key]}");
}
