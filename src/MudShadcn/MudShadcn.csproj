<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>MudShadcn</PackageId>
    <Title>MudShadcn: the shadcn/ui look for MudBlazor</Title>
    <!-- The release workflow packs with the tag's version; keep this equal to it (RELEASE.md). -->
    <Version>1.0.0</Version>
    <Authors>Sardar Qaslany</Authors>
    <Product>MudShadcn</Product>
    <Copyright>Copyright (c) 2026 Sardar Qaslany</Copyright>
    <Description>The shadcn/ui look for every MudBlazor component, charts included: a MudTheme and one stylesheet, in light and dark mode. No new components and no fork: you keep writing MudBlazor with its full API. MudBlazor comes along as a dependency, so MudShadcn is the only package you reference.</Description>
    <PackageTags>blazor;mudblazor;shadcn;shadcn-ui;theme;dark-mode;css;ui;components;blazor-server;blazor-webassembly;dotnet;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The showcase is the package's landing page; the source is RepositoryUrl. -->
    <PackageProjectUrl>https://mudshadcn.pages.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/sardar97/MudShadcn/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/sardar97/MudShadcn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Source Link comes with the .NET SDK; the .snupkg lets debuggers step into the library. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MudBlazor is a normal (non-private) dependency on purpose: it flows transitively to
      consumers, including its static web assets (_content/MudBlazor/*), so a consuming app
      only references MudShadcn. Do not add PrivateAssets here.
    -->
    <PackageReference Include="MudBlazor" Version="9.10.0" />
  </ItemGroup>

  <!--
    Packed at the package root: the README is the repository's (nuget.org shows it, so its links and
    images are absolute), and the icon is a PNG because NuGet does not accept SVG icons. docs/skill.md
    is the agent skill the showcase also serves at /skill.md.
  -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Update="icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\samples\MudShadcn.Showcase\wwwroot\skill.md" Pack="true" PackagePath="docs\" Visible="false" />
  </ItemGroup>

  <!--
    wwwroot/MudShadcn.min.css: MudShadcn.css without comments and redundant whitespace, generated on
    every build that changes the source (it is git-ignored; edit MudShadcn.css only). The first build
    after a clean checkout creates the file after the static web assets were globbed, so it is
    registered explicitly, the way MudBlazor registers its own generated stylesheet.
  -->
  <PropertyGroup>
    <_MudShadcnCss>$(MSBuildProjectDirectory)/wwwroot/MudShadcn.css</_MudShadcnCss>
    <_MudShadcnMinCss>$(MSBuildProjectDirectory)/wwwroot/MudShadcn.min.css</_MudShadcnMinCss>
  </PropertyGroup>

  <Target Name="MinifyMudShadcnCss" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(_MudShadcnCss);$(MSBuildProjectFullPath)" Outputs="$(_MudShadcnMinCss)">
    <MinifyCss Source="$(_MudShadcnCss)" Destination="$(_MudShadcnMinCss)" />
  </Target>

  <Target Name="RegisterMudShadcnMinCss" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="MinifyMudShadcnCss"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_MudShadcnMinCssAsset Include="wwwroot/MudShadcn.min.css" Exclude="@(Content)" />
      <Content Include="@(_MudShadcnMinCssAsset)" />
    </ItemGroup>
  </Target>

  <!--
    A conservative minifier: it drops comments, collapses whitespace and removes it only next to
    { } ; , ( and after : and >, never inside strings, and never where CSS needs it (around + and -
    in calc(), after ")", before ":" of a descendant pseudo-class, before an attribute flag such as
    [fill="#fff" i]). Chromium parses both files to the same rules.
  -->
  <UsingTask TaskName="MinifyCss" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var css = File.ReadAllText(Source);
        var sb = new StringBuilder(css.Length);
        const string NoSpaceAfter = "{};,:(>";
        const string NoSpaceBefore = "{};,)>";
        var pendingSpace = false;
        var i = 0;
        while (i < css.Length)
        {
            var c = css[i];
            if (c == '/' && i + 1 < css.Length && css[i + 1] == '*')
            {
                var end = css.IndexOf("*/", i + 2, StringComparison.Ordinal);
                i = end < 0 ? css.Length : end + 2;
                pendingSpace = true;
                continue;
            }

            if (char.IsWhiteSpace(c))
            {
                pendingSpace = true;
                i++;
                continue;
            }

            if (pendingSpace && sb.Length > 0 && NoSpaceAfter.IndexOf(sb[sb.Length - 1]) < 0 && NoSpaceBefore.IndexOf(c) < 0)
            {
                sb.Append(' ');
            }
            pendingSpace = false;

            if (c == '"' || c == '\'')
            {
                var start = i++;
                while (i < css.Length && css[i] != c)
                {
                    i += css[i] == '\\' ? 2 : 1;
                }
                i = Math.Min(i + 1, css.Length);
                sb.Append(css, start, i - start);
                continue;
            }

            if (c == '}' && sb.Length > 0 && sb[sb.Length - 1] == ';')
            {
                sb.Length--;                                  // the last declaration needs no ';'
            }
            sb.Append(c);
            i++;
        }

        var minified = sb.ToString();
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != minified)
        {
            File.WriteAllText(Destination, minified);
        }
      ]]></Code>
    </Task>
  </UsingTask>

</Project>
