@namespace MudShadcn
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MudShadcnProvider> Logger

<MudThemeProvider @ref="_themeProvider"
                  Theme="@(Enabled ? ShadcnTheme : MudBlazorTheme ?? MudBlazorDefaultTheme)"
                  IsDarkMode="@IsDarkMode"
                  IsDarkModeChanged="@SetDarkModeAsync"
                  ObserveSystemDarkModeChange="@FollowSystemDarkMode"
                  DefaultScrollbar="@DefaultScrollbar" />

@if (Enabled)
{
    @* Rendered after MudThemeProvider's own <style>, so MudShadcn.css sees the tokens of the active mode. *@
    <style>@((MarkupString)TokensCss)</style>

    @* The theme's style, if it has one: a small stylesheet that comes after MudShadcn.css (which the
       page links in its <head>) and so wins over it rule for rule. Only the active style is ever
       fetched; the key makes a change of style replace the element instead of patching its href. *@
    @if (StyleHref is { } href)
    {
        <link @key="href" rel="stylesheet" href="@href" data-mudshadcn-style="@StyleName" />
    }
}

@if (IncludeProviders)
{
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
}

@code {
    // The page's <link> to MudShadcn's stylesheet: the package's own file (plain, minified or
    // fingerprinted), or a link the app marked with data-mudshadcn because it serves a copy.
    private const string StylesheetSelector =
        "link[data-mudshadcn],link[rel~=\"stylesheet\"][href*=\"_content/MudShadcn/MudShadcn\"]";

    private static readonly MudTheme MudBlazorDefaultTheme = new();

    private MudThemeProvider? _themeProvider;

    private MudTheme ShadcnTheme => Theme ?? MudShadcnTheme.Default;

    private string TokensCss => ShadcnTheme is ShadcnTheme theme ? theme.ToCss(IsDarkMode) : ShadcnTokens.ToCss(IsDarkMode);

    // NewYork is MudShadcn.css itself.
    private string? StyleName => ShadcnTheme is ShadcnTheme { Style: not ShadcnStyle.NewYork } theme
        ? theme.Style.ToString().ToLowerInvariant()
        : null;

    private string? StyleHref => StyleName is { } name ? string.Format(System.Globalization.CultureInfo.InvariantCulture, StyleHrefFormat, name) : null;
    private bool _stylesheetOff;    // whether this provider has switched the page's stylesheet off

    /// <summary>
    /// The theme to apply. Defaults to <see cref="MudShadcnTheme.Default"/>. A theme made by
    /// <see cref="MudShadcnTheme"/> (a <see cref="MudShadcn.ShadcnTheme"/>) brings its own shadcn
    /// tokens, radius and style; any other <see cref="MudTheme"/> gets the default ones.
    /// </summary>
    [Parameter]
    public MudTheme? Theme { get; set; }

    /// <summary>
    /// Where the stylesheets of the styles are, with <c>{0}</c> for the style's name in lower case
    /// (<c>vega</c>, <c>nova</c>, …). The default is the minified file the package ships. The
    /// address is relative to the page's <c>&lt;base href&gt;</c>, like the one of MudShadcn.css.
    /// </summary>
    [Parameter]
    public string StyleHrefFormat { get; set; } = "_content/MudShadcn/styles/{0}.min.css";

    /// <summary>
    /// When <c>false</c>, the app has MudBlazor's own look: the provider applies
    /// <see cref="MudBlazorTheme"/>, switches MudShadcn's stylesheet off in the page and stops
    /// emitting the <c>--shadcn-*</c> tokens. Set it back to <c>true</c> (the default) for the
    /// shadcn look. It can change at any time, so an app can offer both looks.
    /// </summary>
    [Parameter]
    public bool Enabled { get; set; } = true;

    /// <summary>
    /// The theme applied while <see cref="Enabled"/> is <c>false</c>. Defaults to MudBlazor's
    /// default theme; pass the <see cref="MudTheme"/> your app used before MudShadcn to keep it.
    /// </summary>
    [Parameter]
    public MudTheme? MudBlazorTheme { get; set; }

    /// <summary>Whether the dark palette is active. Supports <c>@bind-IsDarkMode</c>.</summary>
    [Parameter]
    public bool IsDarkMode { get; set; }

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    /// <summary>
    /// When <c>true</c> (the default, like shadcn's <c>defaultTheme="system"</c>), starts in the
    /// operating system's colour scheme and follows it when it changes.
    /// </summary>
    [Parameter]
    public bool FollowSystemDarkMode { get; set; } = true;

    /// <summary>
    /// When <c>true</c> (the default), also renders <see cref="MudPopoverProvider"/>,
    /// <see cref="MudDialogProvider"/> and <see cref="MudSnackbarProvider"/>, so this is the only
    /// provider a layout needs. Set to <c>false</c> if you place those yourself.
    /// </summary>
    [Parameter]
    public bool IncludeProviders { get; set; } = true;

    /// <summary>Passed through to <see cref="MudThemeProvider.DefaultScrollbar"/>.</summary>
    [Parameter]
    public bool DefaultScrollbar { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // First, so a page that starts with MudBlazor's look spends as little time as possible
        // with MudBlazor's palette on MudShadcn's shapes.
        if (_stylesheetOff == Enabled)
        {
            await SetStylesheetOffAsync(!Enabled);
        }

        if (firstRender && FollowSystemDarkMode && _themeProvider is not null)
        {
            await SetDarkModeAsync(await _themeProvider.GetSystemDarkModeAsync());
        }
    }

    /// <summary>
    /// Leaves the page as the provider found it: the stylesheet applies again, as it does on a
    /// page that has no provider.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_stylesheetOff)
        {
            await SetStylesheetOffAsync(false);
        }
    }

    // CSSStyleSheet.disabled: the stylesheet stays loaded and in its place among the page's
    // stylesheets, so switching is immediate both ways and nothing is fetched again.
    private async Task SetStylesheetOffAsync(bool off)
    {
        _stylesheetOff = off;   // before the first await: a render in the meantime must not start a second switch
        try
        {
            await using var link = await JS.InvokeAsync<IJSObjectReference?>("document.querySelector", StylesheetSelector);
            if (link is null)
            {
                LogStylesheetNotSwitched("no such <link> in the page");
                return;
            }

            await link.SetValueAsync("sheet.disabled", off);
        }
        catch (JSException e)
        {
            LogStylesheetNotSwitched(e.Message);
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException)
        {
            // The circuit is gone, and the page with it.
        }
    }

    private void LogStylesheetNotSwitched(string reason) => Logger.LogWarning(
        "MudShadcnProvider could not switch MudShadcn's stylesheet {State} ({Reason}). Enabled=\"false\" needs the page to "
        + "link it as _content/MudShadcn/MudShadcn.min.css or MudShadcn.css; add the data-mudshadcn attribute to the <link> "
        + "if the app serves the stylesheet from another address.",
        _stylesheetOff ? "off" : "back on", reason);

    private async Task SetDarkModeAsync(bool value)
    {
        if (IsDarkMode == value)
        {
            return;
        }

        IsDarkMode = value;
        await IsDarkModeChanged.InvokeAsync(value);
        StateHasChanged();
    }
}
